# Doxygen configuration for MhLib.
#
# The headers are the API and the design reference. Their comments are written in
# Doxygen's Qt dialect (`/**`, `///`, `//!`, `/*!`, `\brief`, `\param`, …), so this
# file is the one place that renders them. See docs/DOCUMENTATION.md for the
# conventions and for the checks that keep them usable.
#
# Generate into the shadow build tree, never into the source tree:
#
#     doxygen Doxyfile
#     $BROWSER build/doxygen/html/index.html

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "MhLib"
PROJECT_BRIEF          = "The beginnings of a 3D engine and utility library"
OUTPUT_DIRECTORY       = build/doxygen
OUTPUT_LANGUAGE        = English
CREATE_SUBDIRS         = NO
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
IDL_PROPERTY_SUPPORT   = YES
USE_MDFILE_AS_MAINPAGE = README.md
BUILTIN_STL_SUPPORT    = YES

# The project's own headers and its Markdown notes. `extern/` is a submodule, and
# every generated or third-party file is out of scope.
#
# The Markdown files under docs/ describe policy and cross-cutting design notes;
# the per-module READMEs describe what each module currently implements. Doxygen
# nests a page only when another page names it with `\subpage`, so keep the note
# tree shallow (docs/DOCUMENTATION.md §9).
INPUT                  = README.md AGENTS.md Elvavena Test Kaldi KaldiGL KaldiVK KaldiD3D11 KaldiD3D12 KaldiGLES Haruka Lotte Euphemy docs
FILE_PATTERNS          = *.h *.hpp *.md
RECURSIVE              = YES
EXCLUDE                = extern build Elvavena/Util/half.hpp Euphemy/Media/Audio/FFTConvolver
EXCLUDE_PATTERNS       = */build/* */node_modules/* *.inc
INPUT_ENCODING         = UTF-8

# A header is a documentation artifact here: show every declaration, including
# the internal ones, so the reference renders the header as it reads.
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
MARKDOWN_SUPPORT       = YES

# Qt style: `//!` and `/*!` open a doc block, and its first sentence is the
# brief. This is what the headers are written in.
QT_AUTOBRIEF           = YES
JAVADOC_AUTOBRIEF      = NO
MULTILINE_CPP_IS_BRIEF = NO

SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO
SORT_BY_SCOPE_NAME     = NO
TAB_SIZE               = 8
# `@requires` is a project-local alias for a "Requires" paragraph on constrained
# templates; it is not a built-in Doxygen command.
ALIASES                = requires="\\par Requires\n"

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO
GENERATE_AUTOGEN_DEF   = NO
GENERATE_PERLMOD       = NO
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO

# Warnings that matter: a malformed command, a broken block, or a documented
# function whose \param list does not match its signature. A declaration without
# any doc comment is not a warning here — the tree predates the policy and
# docs/DOCUMENTATION.md §3.1 records how that is paid down.
#
# \param completeness is enforced: every parameter of a *documented* function has
# a \param (and \tparam for every template parameter), so a new doc block that
# omits one fails a Doxygen run.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: $text"

HTML_EXTRA_STYLESHEET  = extern/doxygen-awesome-css/doxygen-awesome.css \
                         extern/doxygen-awesome-css/doxygen-awesome-sidebar-only.css
HTML_EXTRA_FILES       = extern/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js \
                         extern/doxygen-awesome-css/doxygen-awesome-fragment-copy-button.js \
                         extern/doxygen-awesome-css/doxygen-awesome-paragraph-link.js \
                         extern/doxygen-awesome-css/doxygen-awesome-interactive-toc.js
HTML_COLORSTYLE        = LIGHT
